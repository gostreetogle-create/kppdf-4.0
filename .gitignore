# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Angular
.angular/
dist/
tmp/
out-tsc/

# Books (heavy files, not for git)
angular/

# Backend
backend/dist/
backend/node_modules/

# Environment
.env
!.env.example

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
*.log

# Knowledge base cache (chromadb binary files)
база-знаний/chroma_db/

# Uploads (user data!)
backend/uploads/*
!backend/uploads/.gitkeep

# Test
coverage/

# Docker
.docker/
docker-compose.override.yml
