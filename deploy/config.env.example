# KPPDF 4.0 — конфиг деплоя (скопируй в config.env и заполни)
# cp deploy/config.env.example deploy/config.env

# --- Платформа ---
# ubuntu  — чистый Ubuntu-сервер (Docker из apt)
# synology — Synology NAS DSM 7+ (Container Manager)
PLATFORM=ubuntu

# --- SSH ---
DEPLOY_HOST=192.168.1.46
DEPLOY_USER=tiit
# DEPLOY_PASSWORD=          # опционально, если нет SSH-ключа

# --- Пути на сервере ---
REMOTE_DIR=/opt/kppdf-4.0
KPPDF_DATA_DIR=/var/lib/kppdf40

# --- Секреты (обязательны) ---
JWT_SECRET=CHANGE_ME_GENERATE_RANDOM_64_HEX
JWT_REFRESH_SECRET=CHANGE_ME_GENERATE_ANOTHER_64_HEX

# --- Домен ---
CORS_ORIGIN=https://sport-set.ru

# --- Порты ---
BACKEND_PORT=4000
MONGODB_PORT=27018
CHROMADB_PORT=8000

# --- Первый деплой ---
SEED=true
