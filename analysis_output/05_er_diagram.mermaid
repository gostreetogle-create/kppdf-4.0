    %% UPDATED 04.06.2026 - NEW ENTITIES FROM D:\invSportiN

    ORGANIZATIONS {
        uuid id PK
        text name
        text short_name
        text legal_form
        text inn UK
        text kpp
        text ogrn UK
        text okpo
        text phone
        text email
        text legal_address
        text bank_name
        text bank_bik
        text bank_account
        uuid parent_counterparty_id FK
        boolean is_branch
        boolean is_government_body
        boolean is_active
        datetime created_at
    }

    CLIENTS {
        uuid id PK
        text last_name
        text first_name
        text patronymic
        text phone
        text email
        text inn UK
        uuid organization_id FK
        float client_markup_percent
        boolean is_active
        datetime created_at
    }

    PRODUCTS {
        uuid id PK
        text sku UK
        text name
        uuid category_id FK
        text unit
        float base_price
        boolean has_passport
        boolean has_drawing
        boolean is_active
        datetime created_at
    }

    PRODUCT_CATEGORIES {
        uuid id PK
        text name
        uuid parent_category_id FK
        text description
        integer sort_order
        datetime created_at
    }

    COMMERCIAL_PROPOSALS {
        uuid id PK
        text number UK
        uuid organization_id FK
        uuid client_id FK
        text status
        float total_amount
        date valid_until
        uuid created_by FK
        datetime created_at
    }

    CONTRACTS {
        uuid id PK
        text number UK
        text contract_type
        uuid organization_id FK
        uuid proposal_id FK
        uuid tender_id FK
        text subject
        float amount
        text status
        date start_date
        date end_date
        datetime created_at
    }

    INVOICES {
        uuid id PK
        text number UK
        uuid contract_id FK
        uuid organization_id FK
        float amount
        text status
        date issued_date
        boolean is_advance
        datetime created_at
    }

    TENDERS {
        uuid id PK
        text name
        text tender_number UK
        uuid customer_organization_id FK
        text type
        float nmck
        text status
        datetime submission_deadline
        datetime created_at
    }

    PROJECTS {
        uuid id PK
        text name
        uuid organization_id FK
        uuid contract_id FK
        text address
        text status
        date start_date
        date end_date
        datetime created_at
    }

    USERS {
        uuid id PK
        text login UK
        text full_name
        text role
        text email
        boolean is_active
        datetime created_at
    }

    === NEW ENTITIES FROM D:\invSportiN ===

    SUPPLIERS {
        uuid id PK
        uuid organization_id FK
        text name
        text contact_person
        text phone
        text email
        text inn UK
        text bank_account
        integer payment_term_days
        boolean is_active
        datetime created_at
    }

    PURCHASES {
        uuid id PK
        text number UK
        uuid supplier_id FK
        uuid organization_id FK
        uuid project_id FK
        text status
        float total_amount
        date order_date
        date delivery_date
        datetime created_at
    }

    PURCHASE_ITEMS {
        uuid id PK
        uuid purchase_id FK
        text name
        float quantity
        text unit
        float unit_price
        float total
    }

    CERTIFICATES {
        uuid id PK
        text number UK
        uuid product_id FK
        uuid organization_id FK
        text name
        text type
        date issued_date
        date expiry_date
        text issuing_authority
        text file_path
        datetime created_at
    }

    PRODUCT_DEVELOPMENTS {
        uuid id PK
        text name
        text project_number UK
        text status
        uuid responsible_user_id FK
        date start_date
        date end_date_planned
        text notes
        datetime created_at
    }

    INVENTOR_FILES {
        uuid id PK
        uuid product_id FK
        text file_name
        text file_path
        text file_type
        text inventor_type
        text version
        boolean is_current
        text old_version_path
        datetime last_modified
        datetime created_at
    }

    SKU_COUNTERS {
        text prefix PK
        text category_name
        integer current_counter
        integer max_counter
        datetime updated_at
    }

